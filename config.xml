<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>

  <module name="global">
    <param name="coordinateSystem" value="EPSG:32647"/>
    <param name="numberOfThreads" value="4"/>
    <param name="randomSeed" value="4711"/>
  </module>

  <module name="network">
    <param name="inputNetworkFile" value="input/network.xml.gz"/>
  </module>

  <module name="plans">
    <param name="inputPlansFile" value="input/population.xml.gz"/>
  </module>

  <module name="transit">
    <param name="useTransit" value="true"/>
    <param name="transitScheduleFile" value="input/transitSchedule.xml.gz"/>
    <param name="vehiclesFile" value="input/transitVehicles.xml.gz"/>
    <param name="transitModes" value="pt"/>
  </module>

  <module name="controller">
    <param name="outputDirectory" value="./output/base"/>
    <param name="firstIteration" value="0"/>
    <param name="lastIteration" value="20"/>
    <param name="overwriteFiles" value="deleteDirectoryIfExists"/>
    <param name="writeEventsInterval" value="10"/>
    <param name="writePlansInterval" value="10"/>
    <param name="routingAlgorithmType" value="SpeedyALT"/>
    <param name="compressionType" value="gzip"/>
  </module>

  <module name="qsim">
    <param name="startTime" value="06:00:00"/>
    <param name="endTime" value="23:00:00"/>
    <param name="flowCapacityFactor" value="1.0"/>
    <param name="storageCapacityFactor" value="1.0"/>
    <param name="numberOfThreads" value="4"/>
    <param name="snapshotStyle" value="queue"/>
    <param name="vehiclesSource" value="defaultVehicle"/>
  </module>

  <module name="routing">
    <param name="networkModes" value="car"/>
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="walk"/>
      <param name="teleportedModeSpeed" value="1.1"/>
      <param name="beelineDistanceFactor" value="1.35"/>
    </parameterset>
  </module>

  <module name="transitRouter">
    <param name="searchRadius" value="600.0"/>
    <param name="extensionRadius" value="300.0"/>
    <param name="maxBeelineWalkConnectionDistance" value="400.0"/>
    <param name="additionalTransferTime" value="30.0"/>
  </module>

  <module name="scoring">
    <param name="learningRate" value="1.0"/>
    <param name="BrainExpBeta" value="2.0"/>
    <parameterset type="scoringParameters">
      <param name="lateArrival" value="-18.0"/>
      <param name="earlyDeparture" value="-0.0"/>
      <param name="performing" value="6.0"/>
      <param name="waiting" value="-0.0"/>
      <!-- การรอรถรู้สึก "แพง" กว่าการนั่งอยู่บนรถประมาณ 2 เท่า -->
      <param name="waitingPt" value="-6.0"/>

      <parameterset type="activityParams">
        <param name="activityType" value="home"/>
        <param name="typicalDuration" value="12:00:00"/>
        <param name="minimalDuration" value="01:00:00"/>
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="class"/>
        <param name="typicalDuration" value="01:30:00"/>
        <param name="minimalDuration" value="00:30:00"/>
        <param name="openingTime" value="07:00:00"/>
        <param name="closingTime" value="21:00:00"/>
      </parameterset>

      <parameterset type="modeParams">
        <param name="mode" value="car"/>
        <param name="marginalUtilityOfTraveling_util_hr" value="-6.0"/>
        <param name="monetaryDistanceRate" value="0.0"/>
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="pt"/>
        <param name="constant" value="-0.5"/>
        <param name="marginalUtilityOfTraveling_util_hr" value="-3.0"/>
        <param name="monetaryDistanceRate" value="0.0"/>
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="walk"/>
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0"/>
        <param name="monetaryDistanceRate" value="0.0"/>
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="transit_walk"/>
        <param name="marginalUtilityOfTraveling_util_hr" value="-8.0"/>
        <param name="monetaryDistanceRate" value="0.0"/>
      </parameterset>
    </parameterset>
  </module>

  <module name="replanning">
    <param name="maxAgentPlanMemorySize" value="5"/>
    <param name="fractionOfIterationsToDisableInnovation" value="0.8"/>
    <parameterset type="strategysettings">
      <param name="strategyName" value="ChangeExpBeta"/>
      <param name="weight" value="0.70"/>
    </parameterset>
    <parameterset type="strategysettings">
      <param name="strategyName" value="ReRoute"/>
      <param name="weight" value="0.15"/>
    </parameterset>
    <parameterset type="strategysettings">
      <param name="strategyName" value="TimeAllocationMutator"/>
      <param name="weight" value="0.15"/>
    </parameterset>
  </module>

</config>